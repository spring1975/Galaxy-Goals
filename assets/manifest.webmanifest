{
  "name": "Galaxy Goals",
  "id": "/Galaxy-Goals/",
  "short_name": "GalaxyGoals",
  "theme_color": "#22223b",
  "background_color": "#f2e9e4",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "scope": "/",
  "start_url": "/",
  "description": "Track and achieve your goals in the Galaxy Goals app.",
  "icons": [
    {
      "src": "icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "screenshots/mobile.png",
      "sizes": "375x667",
      "type": "image/png"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+galaxygoals",
      "url": "/Galaxy-Goals/?url=%s"
    }
  ]
}
